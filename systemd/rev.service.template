# Linux counterpart of launchd/com.naps62.rev.plist.template. Placeholders are
# substituted by scripts/install-service.sh, so this cannot be enabled as-is.
[Unit]
Description=rev — always-on local code review server
After=network.target

[Service]
Type=simple
WorkingDirectory=@CHECKOUT@
ExecStart=@NODE@ server/index.ts
Environment=PATH=@PATH@
Environment=NODE_ENV=production
Environment=REV_ROOTS=%h
Environment=REV_DEPTH=3
# Entity-level diffs (optional); user-unit PATH doesn't include ~/.local/bin
Environment=REV_SEM_BIN=%h/.local/bin/sem
# Per-machine overrides (REV_PORT, REV_HOST, ...) go in ~/.config/rev/env,
# which the server reads itself — this file is regenerated on every deploy.
Restart=always
RestartSec=2

[Install]
WantedBy=default.target
