{
  "name": "rev",
  "private": true,
  "version": "0.3.1",
  "type": "module",
  "packageManager": "pnpm@10.32.1",
  "engines": {
    "node": ">=26"
  },
  "imports": {
    "#shared/*": "./shared/*.ts"
  },
  "scripts": {
    "dev": "pnpm run --silent dev:server & pnpm run --silent dev:web & wait",
    "dev:server": "node --watch server/index.ts",
    "dev:web": "vite",
    "build": "vite build",
    "bundle": "esbuild server/index.ts --bundle --platform=node --format=esm --target=node26 --outfile=dist/rev.js --banner:js='import{createRequire as __cr}from\"node:module\";const require=__cr(import.meta.url);'",
    "package": "./scripts/package.sh",
    "start": "NODE_ENV=production node server/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --test \"server/**/*.test.ts\" \"web/src/**/*.test.ts\""
  },
  "dependencies": {
    "@hono/node-server": "^1",
    "@tanstack/react-query": "^5",
    "chokidar": "^4",
    "hono": "^4",
    "react": "^19",
    "react-dom": "^19",
    "shiki": "^3",
    "wouter": "^3",
    "ws": "^8"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4",
    "@types/node": "^26",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/ws": "^8",
    "@vitejs/plugin-react": "^4",
    "esbuild": "^0.28",
    "expect": "^30",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vite": "^6"
  }
}
